version: '3.8'
services:
  nginx:
    image: nginx:latest
    ports:
      - "80:80"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf
      - ./static_collected:/static:ro
    depends_on:
      - backend1
      - backend2
      - backend3

  backend1:
    build: .
    environment:
      - PORT=5001
      - DJANGO_SETTINGS_MODULE=auth_project.settings
      - POSTGRES_DB=mydb
      - POSTGRES_USER=user
      - POSTGRES_PASSWORD=password
      - POSTGRES_HOST=db
      - POSTGRES_PORT=5432
    depends_on:
      - db
    volumes:
      - ./static_collected:/app/static_collected

  backend2:
    build: .
    environment:
      - PORT=5002
      - DJANGO_SETTINGS_MODULE=auth_project.settings
      - POSTGRES_DB=mydb
      - POSTGRES_USER=user
      - POSTGRES_PASSWORD=password
      - POSTGRES_HOST=db
      - POSTGRES_PORT=5432
    depends_on:
      - db
    volumes:
      - ./static_collected:/app/static_collected

  backend3:
    build: .
    environment:
      - PORT=5003
      - DJANGO_SETTINGS_MODULE=auth_project.settings
      - POSTGRES_DB=mydb
      - POSTGRES_USER=user
      - POSTGRES_PASSWORD=password
      - POSTGRES_HOST=db
      - POSTGRES_PORT=5432
    depends_on:
      - db
    volumes:
      - ./static_collected:/app/static_collected

  db:
    image: postgres:17
    environment:
      - POSTGRES_USER=user
      - POSTGRES_PASSWORD=password
      - POSTGRES_DB=mydb
    volumes:
      - postgres_data:/var/lib/postgresql/data

volumes:
  postgres_data:
