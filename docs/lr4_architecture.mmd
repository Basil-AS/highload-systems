%% Mermaid architecture diagram for LR4 (Variant 8: Search System)
flowchart LR
  subgraph "DNS (Round Robin / Simulation)"
    DNS_NODE[DNS]
  end

  subgraph "Nginx Reverse Proxy + Cache"
    NGINX[Nginx]
  end

  subgraph "Frontend Static"
    FEUI[Static UI]
  end

  subgraph "API Layer"
    APIGW[API Gateway / Router]
  end

  subgraph "Microservices"
    USVC[User Service v1/v2]
    QSVC[Search/Query Service]
    DSVC[Document Service]
  end

  subgraph "Queue"
    Q[RabbitMQ / ValKey Streams]
  end

  subgraph "Workers"
    IDX[Indexers]
  end

  subgraph "Cache"
    REDIS[Redis (ValKey)]
  end

  subgraph "Databases"
    PRIMARY[(PostgreSQL Primary)]
    REPLICA[(PostgreSQL Replica RO)]
    AUDIT[(Audit DB - events, partitions by date)]
  end

  subgraph "Monitoring"
    PROM[Prometheus]
    GRAF[Grafana]
  end

  subgraph "Backups"
    BACKUP[(pg_dump / WAL / MinIO S3)]
  end

  %% Edges
  DNS_NODE --> NGINX
  NGINX --> FEUI
  FEUI --> NGINX
  NGINX --> APIGW
  APIGW --> USVC
  APIGW --> QSVC
  APIGW --> DSVC

  QSVC --> REDIS
  QSVC --> REPLICA
  QSVC --> Q
  DSVC --> Q
  IDX --> PRIMARY
  IDX --> AUDIT
  USVC --> PRIMARY
  USVC --> AUDIT

  PRIMARY --> REPLICA
  APIGW --> REDIS

  PROM --> NGINX
  PROM --> APIGW
  PROM --> USVC
  PROM --> QSVC
  PROM --> DSVC
  PROM --> PRIMARY
  PROM --> REPLICA
  PROM --> Q
  PROM --> IDX
  PROM --> REDIS
  GRAF --> PROM

  PRIMARY --> BACKUP
  BACKUP --> PRIMARY