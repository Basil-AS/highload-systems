    QSVC[Search/Query Service]
    DSVC[Document Service]
  end

  subgraph MQ["Queue"]
    Q[RabbitMQ / ValKey Streams]
  end

  subgraph WORK["Workers"]
    IDX[Indexers]
  end

  subgraph CACHE["Cache"]
    REDIS[Redis (ValKey)]
  end

  subgraph DB["Databases"]
