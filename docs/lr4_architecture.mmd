%% Mermaid architecture diagram for LR4 (Variant 8: Search System)
flowchart LR
  subgraph DNS["DNS (Round Robin / Simulation)"]
    DNS_NODE[DNS]
  end

  subgraph Edge["Nginx Reverse Proxy + Cache"]
    NGINX[Nginx]
  end

  subgraph FE["Frontend Static"]
    FEUI[Static UI]
  end

  subgraph API["API Layer"]
    APIGW[API Gateway / Router]
  end

  subgraph SVC["Microservices"]
